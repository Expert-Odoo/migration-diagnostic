<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action du wizard définie ICI, avant le menuitem qui la référence -->
    <record id="action_migration_scan_wizard" model="ir.actions.act_window">
        <field name="name">Nouveau diagnostic de migration</field>
        <field name="res_model">migration.scan.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_migration_diagnostic_root"
              name="Migration Diagnostic"
              web_icon="migration_diagnostic,static/description/icon.png"
              sequence="90"/>

    <menuitem id="menu_migration_diagnostic_new"
              name="Nouveau diagnostic"
              parent="menu_migration_diagnostic_root"
              action="migration_diagnostic.action_migration_scan_wizard"
              sequence="1"/>

    <menuitem id="menu_migration_diagnostic_list"
              name="Historique des diagnostics"
              parent="menu_migration_diagnostic_root"
              action="migration_diagnostic.action_migration_diagnostic"
              sequence="2"/>
</odoo>
