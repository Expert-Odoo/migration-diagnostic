<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════════
         VUES STANDALONE — tag racine <tree> obligatoire pour ir.ui.view.type
         Les decoration-* sont validés dans le contexte du bon modèle ici
    ════════════════════════════════════════════════════════════════════════ -->

    <record id="view_migration_risk_list_embedded" model="ir.ui.view">
        <field name="name">migration.diagnostic.risk.list.embedded</field>
        <field name="model">migration.diagnostic.risk</field>
        <field name="arch" type="xml">
            <tree decoration-success="risk_level == 'low'"
                  decoration-warning="risk_level == 'medium'"
                  decoration-danger="risk_level == 'high'">
                <field name="risk_level" widget="badge"/>
                <field name="name"/>
                <field name="description"/>
                <field name="recommendation"/>
            </tree>
        </field>
    </record>

    <record id="view_migration_volume_list_embedded" model="ir.ui.view">
        <field name="name">migration.diagnostic.volume.list.embedded</field>
        <field name="model">migration.diagnostic.volume</field>
        <field name="arch" type="xml">
            <tree decoration-warning="volume_level == 'high'"
                  decoration-danger="volume_level == 'critical'">
                <field name="phase"/>
                <field name="migration_priority" string="Order"/>
                <field name="label"/>
                <field name="model_name"/>
                <field name="record_count" sum="Total"/>
                <field name="volume_level" widget="badge"/>
                <field name="available" widget="boolean"/>
            </tree>
        </field>
    </record>

    <record id="view_migration_module_list_embedded" model="ir.ui.view">
        <field name="name">migration.diagnostic.module.list.embedded</field>
        <field name="model">migration.diagnostic.module</field>
        <field name="arch" type="xml">
            <tree decoration-danger="category == 'custom'"
                  decoration-warning="category == 'oca'">
                <field name="category" widget="badge"/>
                <field name="name"/>
                <field name="shortdesc"/>
                <field name="author"/>
                <field name="installed_version"/>
                <field name="risk_level" widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         DIAGNOSTIC — Form view
    ════════════════════════════════════════════════════════════════════════ -->
    <record id="view_migration_diagnostic_form" model="ir.ui.view">
        <field name="name">migration.diagnostic.form</field>
        <field name="model">migration.diagnostic</field>
        <field name="arch" type="xml">
            <form string="Migration diagnostic">
                <header>
                    <button name="action_run_scan" type="object"
                            string="🔍 Re-run scan"
                            class="btn-primary"
                            attrs="{'invisible': [('state', '=', 'scanning')]}"/>
                    <button name="action_reset_draft" type="object"
                            string="Reset"
                            attrs="{'invisible': [('state', '=', 'draft')]}"/>
                    <button name="action_open_report" type="object"
                            string="📄 Export PDF"
                            attrs="{'invisible': [('state', '!=', 'done')]}"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,scanning,done"/>
                </header>

                <sheet>
                    <div class="alert alert-danger" role="alert" attrs="{'invisible': [('state', '!=', 'error')]}">
                        <b>Scan error:</b>
                        <field name="error_message" readonly="1"/>
                    </div>

                    <div attrs="{'invisible': [('state', '!=', 'done')]}" style="margin-bottom:16px;">
                        <field name="complexity_level" widget="badge"
                               decoration-success="complexity_level == 'low'"
                               decoration-warning="complexity_level == 'medium'"
                               decoration-danger="complexity_level in ('high', 'critical')"/>
                        <span class="ml-3 font-weight-bold" style="font-size:1.25rem;">
                            Score: <field name="complexity_score" readonly="1"/> / 100
                        </span>
                        <span class="ml-4 text-muted">
                            Estimate: <field name="estimated_days_label" readonly="1"/>
                        </span>
                    </div>

                    <div class="oe_title">
                        <h1><field name="name" placeholder="Diagnostic name"/></h1>
                    </div>

                    <group>
                        <group string="Information">
                            <field name="source_version"/>
                            <field name="scan_date"/>
                            <field name="scan_duration" string="Duration (s)"/>
                            <field name="company_count"/>
                            <field name="has_multicompany" widget="boolean_toggle"/>
                        </group>
                        <group string="Customizations">
                            <field name="custom_field_count"/>
                            <field name="server_action_python_count"/>
                            <field name="automation_rule_count"/>
                        </group>
                    </group>

                    <group string="Module inventory">
                        <group>
                            <field name="module_count_total"/>
                            <field name="module_count_standard"/>
                        </group>
                        <group>
                            <field name="module_count_oca"/>
                            <field name="module_count_custom"/>
                        </group>
                    </group>

                    <group string="Data">
                        <field name="total_records" string="Total estimated records"/>
                    </group>

                    <notebook>
                        <page string="📋 Recommendations" attrs="{'invisible': [('state', '!=', 'done')]}">
                            <field name="recommendation" widget="html" nolabel="1" readonly="1"/>
                            <separator string="Phase 1 — Reference data"/>
                            <field name="phase1_notes" widget="html" nolabel="1" readonly="1"/>
                            <separator string="Phase 2 — Business data"/>
                            <field name="phase2_notes" widget="html" nolabel="1" readonly="1"/>
                        </page>

                        <page string="⚠️ Risk factors">
                            <field name="risk_line_ids" readonly="1"
                                   context="{'tree_view_ref': 'migration_diagnostic.view_migration_risk_list_embedded'}"/>
                        </page>

                        <page string="📊 Data volumes">
                            <field name="volume_line_ids" readonly="1"
                                   context="{'tree_view_ref': 'migration_diagnostic.view_migration_volume_list_embedded'}"/>
                        </page>

                        <page string="📦 Installed modules">
                            <field name="module_line_ids" readonly="1"
                                   context="{'tree_view_ref': 'migration_diagnostic.view_migration_module_list_embedded'}"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         DIAGNOSTIC — List view
    ════════════════════════════════════════════════════════════════════════ -->
    <record id="view_migration_diagnostic_list" model="ir.ui.view">
        <field name="name">migration.diagnostic.list</field>
        <field name="model">migration.diagnostic</field>
        <field name="arch" type="xml">
            <tree decoration-success="complexity_level == 'low'"
                  decoration-warning="complexity_level == 'medium'"
                  decoration-danger="complexity_level in ('high', 'critical')">
                <field name="name"/>
                <field name="source_version"/>
                <field name="scan_date"/>
                <field name="complexity_level" widget="badge"/>
                <field name="complexity_score"/>
                <field name="estimated_days_label" string="Estimate"/>
                <field name="module_count_total"/>
                <field name="module_count_custom"/>
                <field name="total_records"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         ACTION principale
    ════════════════════════════════════════════════════════════════════════ -->
    <record id="action_migration_diagnostic" model="ir.actions.act_window">
        <field name="name">Migration diagnostics</field>
        <field name="res_model">migration.diagnostic</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Run your first diagnostic</p>
            <p>Scan your Odoo database to get a migration feasibility report.</p>
        </field>
    </record>

</odoo>
