"        <tr style=\"border-bottom:1px solid #e5e7eb;\">\n"
"            <td style=\"padding:8px 12px; font-weight:bold; color:#3730a3;\">7</td>\n"
"            <td style=\"padding:8px 12px;\"><b>mail.message</b><br/><span style=\"color:#888;font-size:11px;\">Chatter</span></td>\n"
