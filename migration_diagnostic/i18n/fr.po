msgstr "Résultat du diagnostic"

msgid ""
"\n"
"        <div class=\"alert alert-info\">\n"
"            <b>🔍 What the scan analyzes:</b><br/>\n"
"            <ul>\n"
"                <li>Complete inventory of installed modules (standard / OCA / custom)</li>\n"
"                <li>Volume of critical data (partners, invoices, orders...)</li>\n"
"                <li>Detection of risk factors (multi-company, custom fields, Python actions...)</li>\n"
"                <li>Overall complexity score and effort estimate</li>\n"
"                <li>Recommendations by migration phase</li>\n"
"            </ul>\n"
"            <b>⏱ Estimated duration:</b> 10 to 60 seconds depending on database size.\n"
"        </div>\n"
"        "
msgstr ""
"\n"
"        <div class=\"alert alert-info\">\n"
"            <b>🔍 Ce que le scan analyse :</b><br/>\n"
"            <ul>\n"
"                <li>Inventaire complet des modules installés (standard / OCA / custom)</li>\n"
"                <li>Volumétrie des données critiques (partenaires, factures, commandes...)</li>\n"
"                <li>Détection des facteurs de risque (multi-société, champs custom, actions Python...)</li>\n"
"                <li>Score de complexité globale et estimation de charge</li>\n"
"                <li>Recommandations par phase de migration</li>\n"
"            </ul>\n"
